import express from "express";
import fetch from "node-fetch";

const router = express.Router();
const GEMINI_URL = process.env.GEMINI_URL;
const GEMINI_KEY = process.env.GEMINI_KEY;

// ================= Helper: Gemini API =================
async function callGeminiAPI(prompt, imageBase64 = null) {
  try {
    if (!GEMINI_KEY) throw new Error("GEMINI_KEY is not set");

    const body = {
      contents: [
        {
          parts: [
            { text: prompt },
            ...(imageBase64
              ? [{ inlineData: { mimeType: "image/png", data: imageBase64 } }]
              : []),
          ],
        },
      ],
    };

    const url = `${GEMINI_URL}?key=${GEMINI_KEY}`;
    const res = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    });

    if (!res.ok) {
      const errorText = await res.text();
      console.error("Gemini API Error Response:", errorText);
      throw new Error(
        `Gemini API request failed: ${res.status} ${res.statusText}`
      );
    }

    const data = await res.json();
    const text = data.candidates?.[0]?.content?.parts?.[0]?.text;
    if (!text) throw new Error("No text returned from Gemini API");

    return text;
  } catch (err) {
    console.error("Gemini API Error:", err);
    throw new Error(`Gemini API failed: ${err.message}`);
  }
}

// ================= Main Controller =================
export async function analyzeBillboard(
  imageBase64,
  description,
  latitude,
  longitude
) {
  try {
    const prompt = `You are an AI billboard risk assessor. Analyze this image and return structured JSON.

Tasks:
1. Extract all visible text in the billboard (string).
2. Determine the main violation category. Choose from:
   - Structural Hazard
   - Content Violation
   - Size & Placement
   - Safety Hazard
   - Regulatory Compliance
   - Environmental Impact
3. Analyze billboard content. Return:
   { "obscene_detected": boolean, "political_detected": boolean, "content_compliant": boolean }
4. Analyze structure. Return:
   { "structural_damage": boolean, "leaning": boolean, "broken_parts": boolean, "structural_hazard": boolean }
5. Analyze size & placement. Return:
   { "size_appropriate": boolean, "obstructs_traffic": boolean, "blocks_visibility": boolean, "too_close_to_road": boolean }
6. Perform risk analysis using:
   - Description: "${description}"
   - Location: (lat: ${latitude}, lng: ${longitude})
   - Extracted Text
   - Above analyses
   Guidelines:
   - High Risk (>=70%): Serious hazards or illegal/obscene content.
   - Medium Risk (41-69%): Some issues but not immediately dangerous.
   - Low Risk (0-40%): Safe and compliant.

Return JSON ONLY in this format:
{
  "extractedText": string,
  "aiCategory": string,
  "contentAnalysis": { "obscene_detected": boolean, "political_detected": boolean, "content_compliant": boolean },
  "structuralAnalysis": { "structural_damage": boolean, "leaning": boolean, "broken_parts": boolean, "structural_hazard": boolean },
  "sizeAnalysis": { "size_appropriate": boolean, "obstructs_traffic": boolean, "blocks_visibility": boolean, "too_close_to_road": boolean },
  "riskPercentage": number,
  "riskLevel": "High" | "Medium" | "Low",
  "riskReason": string
}`;

    const response = await callGeminiAPI(prompt, imageBase64);

    // Try to parse JSON
    const jsonMatch = response.match(/\{[\s\S]*\}/);
    if (jsonMatch) {
      return JSON.parse(jsonMatch[0]);
    }

    // Fallback if Gemini output not clean
    return {
      extractedText: "",
      aiCategory: "Safety Hazard",
      contentAnalysis: {
        obscene_detected: false,
        political_detected: false,
        content_compliant: true,
      },
      structuralAnalysis: {
        structural_damage: false,
        leaning: false,
        broken_parts: false,
        structural_hazard: false,
      },
      sizeAnalysis: {
        size_appropriate: true,
        obstructs_traffic: false,
        blocks_visibility: false,
        too_close_to_road: false,
      },
      riskPercentage: 35,
      riskLevel: "Low",
      riskReason: "Default fallback",
    };
  } catch (err) {
    console.error("Billboard Analysis Error:", err);
    return {
      extractedText: "",
      aiCategory: "Safety Hazard",
      contentAnalysis: {
        obscene_detected: false,
        political_detected: false,
        content_compliant: true,
      },
      structuralAnalysis: {
        structural_damage: false,
        leaning: false,
        broken_parts: false,
        structural_hazard: false,
      },
      sizeAnalysis: {
        size_appropriate: true,
        obstructs_traffic: false,
        blocks_visibility: false,
        too_close_to_road: false,
      },
      riskPercentage: 25,
      riskLevel: "Medium",
      riskReason: `Analysis failed: ${err.message}`,
    };
  }
}

export default router;
